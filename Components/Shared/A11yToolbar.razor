@inject AppStateService AppState

<aside class="a11y-bar" aria-label="Accessibility settings and language options">
  <div class="container a11y-container">
    <div class="a11y-tools">
      <span class="a11y-label">@AppState.T("a11yBarTitle"):</span>
      <div class="a11y-btn-group" role="group" aria-label="Font sizing">
        <button type="button" id="btn-font-dec" @onclick="AppState.DecreaseFont" class="a11y-btn" aria-label="Decrease text size">A-</button>
        <button type="button" id="btn-font-reset" @onclick="AppState.ResetFont" class="a11y-btn" aria-label="Reset text size to 100%">A</button>
        <button type="button" id="btn-font-inc" @onclick="AppState.IncreaseFont" class="a11y-btn" aria-label="Increase text size">A+</button>
      </div>
      
      <button type="button" id="btn-contrast-toggle" @onclick="AppState.ToggleContrast" class="a11y-btn @(AppState.Theme == "high-contrast" ? "active" : "")" aria-pressed="@(AppState.Theme == "high-contrast" ? "true" : "false")" aria-label="Toggle High Contrast Mode">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a10 10 0 0 0 0 20z" fill="currentColor"></path></svg>
        <span class="a11y-btn-text">@(AppState.Theme == "high-contrast" ? (AppState.CurrentLanguage == "bn" ? "স্বাভাবিক মোড" : "Normal Mode") : AppState.T("contrastHigh"))</span>
      </button>

      <button type="button" id="btn-dyslexia-toggle" @onclick="AppState.ToggleDyslexicFont" class="a11y-btn" aria-label="Toggle dyslexia-friendly font">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
        <span class="a11y-btn-text">@AppState.T("dyslexiaFont")</span>
      </button>

      <button type="button" id="btn-read-aloud" @onclick="HandleReadAloud" class="a11y-btn" aria-label="Read page content aloud">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
        <span class="a11y-btn-text">@AppState.T("readAloud")</span>
      </button>
    </div>

    <!-- Language Selector -->
    <div class="lang-switch" role="group" aria-label="Language Selector">
      <button type="button" id="btn-lang-en" @onclick="@(() => AppState.SetLanguage("en"))" class="lang-btn @(AppState.CurrentLanguage == "en" ? "active" : "")">English</button>
      <span style="color:#64748B" aria-hidden="true">|</span>
      <button type="button" id="btn-lang-bn" @onclick="@(() => AppState.SetLanguage("bn"))" class="lang-btn @(AppState.CurrentLanguage == "bn" ? "active" : "")">বাংলা</button>
    </div>
  </div>
</aside>
