@page "/forgot-password"
@inject AppStateService AppState
@inject NavigationManager Navigation

<PageTitle>@(AppState.CurrentLanguage == "bn" ? "পাসওয়ার্ড পুনরুদ্ধার | স্টোরিজ অফ ইনক্লুশন" : "Reset Password | Stories of Inclusion")</PageTitle>

<section class="section-pad auth-section">
  <div class="container auth-container">
    
    <div class="auth-card">
      <div class="auth-card-top-plaque">
        <div class="auth-card-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>Self-Service Account Recovery</span>
        </div>
        <h2 class="auth-card-title">Password Recovery</h2>
        <p class="auth-card-subtitle">Provide your verified email and we will send you a one-time reset code and secure access link.</p>
      </div>

      @if (IsSubmitted)
      {
        <div class="auth-recovery-success" role="status">
          <div class="auth-recovery-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          </div>
          <h3 class="auth-recovery-heading">Recovery Dispatch Sent!</h3>
          <p class="auth-recovery-text">
            A password reset email has been generated for <strong>@Email</strong>.
          </p>
          <div class="auth-token-box">
            <span class="auth-token-label">Test Environment Temporary Token:</span>
            <code class="auth-token-code">SOI-AUTH-@ResetCode</code>
          </div>
          <p class="auth-recovery-note">
            In production, this link expires after 15 minutes in compliance with our security policy.
          </p>
          <div style="margin-top:20px; display:flex; flex-direction:column; gap:10px;">
            <NavLink href="login" class="btn btn-primary" style="width:100%; justify-content:center;">
              <span>← Return to Sign In</span>
            </NavLink>
            <button type="button" class="btn btn-secondary" style="width:100%; justify-content:center;" @onclick="ResetForm">
              <span>Send to Another Email Address</span>
            </button>
          </div>
        </div>
      }
      else
      {
        <!-- Reset Request Form -->
        <EditForm Model="@this" OnValidSubmit="HandleSubmit" class="auth-form">
          <DataAnnotationsValidator />

          @if (!string.IsNullOrEmpty(ErrorMessage))
          {
            <div class="auth-alert error" role="alert">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span>@ErrorMessage</span>
            </div>
          }

          <div class="form-group">
            <label for="forgot-email" class="form-label">Registered Email Address *</label>
            <div class="input-with-icon">
              <span class="input-lead-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              </span>
              <InputText id="forgot-email" 
                         type="email" 
                         class="form-input" 
                         @bind-Value="Email" 
                         placeholder="e.g. member@storiesofinclusion.org" 
                         required 
                         aria-required="true" />
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-auth-submit" disabled="@IsLoading">
            @if (IsLoading)
            {
              <span class="auth-spinner" aria-hidden="true"></span>
              <span>Sending Verification Link...</span>
            }
            else
            {
              <span>Send Recovery Code</span>
              <span aria-hidden="true">→</span>
            }
          </button>
        </EditForm>

        <div class="auth-card-footer">
          <p>Remembered your password?</p>
          <NavLink href="login" class="auth-register-link">
            <span>← Back to Sign In</span>
          </NavLink>
        </div>
      }
    </div>

  </div>
</section>
