@page "/role-login"
@inject AppStateService AppState

<PageTitle>Direct Role Access | Stories of Inclusion</PageTitle>

<section class="section-pad" style="padding-top: 40px; padding-bottom: 80px;">
  <div class="container" style="max-width: 900px;">
    
    <div style="text-align: center; margin-bottom: 40px;">
      <span class="badge" style="background: rgba(20, 184, 166, 0.2); color: #2DD4BF; margin-bottom: 12px; display: inline-block;">
        Role-Based Direct Access
      </span>
      <h1 style="font-size: 2.2rem; font-weight: 800; margin-bottom: 12px; color: var(--text-main);">
        Direct Role Access Links
      </h1>
      <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto; line-height: 1.6;">
        Authenticate directly as any system role by visiting its link or clicking below. No forms or credentials required for development and testing.
      </p>
      
      <div style="margin-top: 16px; display: inline-flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.05); padding: 8px 16px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.1);">
        <span style="font-size: 0.85rem; color: var(--text-muted);">Current Active Role:</span>
        <strong style="color: var(--color-accent-teal);">@AppState.GetRoleDisplayName()</strong>
        @if (AppState.CurrentUser != null)
        {
          <span style="font-size: 0.8rem; color: var(--text-muted);">(@AppState.CurrentUser.FullName)</span>
        }
      </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
      
      <!-- SuperAdmin Card -->
      <article style="background: var(--bg-surface); border: 1px solid rgba(124, 58, 237, 0.35); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; position: relative; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.15);">
        <div style="position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, #7C3AED, #A78BFA);"></div>
        <div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
            <span style="background: rgba(124, 58, 237, 0.2); color: #C4B5FD; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 6px; text-transform: uppercase;">
              Executive Tier
            </span>
            <span style="font-size: 0.8rem; color: var(--text-muted);">/dashboard/superadmin</span>
          </div>
          <h2 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 8px; color: #FFFFFF;">SuperAdmin</h2>
          <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5; margin-bottom: 16px;">
            Full administrative authority: user role management, system audit logs, and security controls.
          </p>
          <div style="background: rgba(0,0,0,0.25); border: 1px dashed rgba(255,255,255,0.15); border-radius: 8px; padding: 10px; margin-bottom: 20px;">
            <div style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px;">Direct Link URL</div>
            <code style="color: #A78BFA; font-size: 0.85rem; word-break: break-all;">/any_user_login/superadmin</code>
          </div>
        </div>
        <a href="/any_user_login/superadmin" class="btn btn-primary" style="width: 100%; text-align: center; background: #7C3AED; border-color: #6D28D9;">
          Login as SuperAdmin →
        </a>
      </article>

      <!-- Staff Admin Card -->
      <article style="background: var(--bg-surface); border: 1px solid rgba(20, 184, 166, 0.35); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; position: relative; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.15);">
        <div style="position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, #14B8A6, #2DD4BF);"></div>
        <div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
            <span style="background: rgba(20, 184, 166, 0.2); color: #2DD4BF; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 6px; text-transform: uppercase;">
              Staff Tier
            </span>
            <span style="font-size: 0.8rem; color: var(--text-muted);">/dashboard/admin</span>
          </div>
          <h2 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 8px; color: #FFFFFF;">Staff Admin</h2>
          <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5; margin-bottom: 16px;">
            Review contact & volunteer submissions, manage team member portfolios, and publish audiobooks.
          </p>
          <div style="background: rgba(0,0,0,0.25); border: 1px dashed rgba(255,255,255,0.15); border-radius: 8px; padding: 10px; margin-bottom: 20px;">
            <div style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px;">Direct Link URL</div>
            <code style="color: #2DD4BF; font-size: 0.85rem; word-break: break-all;">/any_user_login/admin</code>
          </div>
        </div>
        <a href="/any_user_login/admin" class="btn btn-primary" style="width: 100%; text-align: center;">
          Login as Staff Admin →
        </a>
      </article>

      <!-- Member / User Card -->
      <article style="background: var(--bg-surface); border: 1px solid rgba(59, 130, 246, 0.35); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; position: relative; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.15);">
        <div style="position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, #3B82F6, #60A5FA);"></div>
        <div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
            <span style="background: rgba(59, 130, 246, 0.2); color: #93C5FD; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 6px; text-transform: uppercase;">
              Member Tier
            </span>
            <span style="font-size: 0.8rem; color: var(--text-muted);">/dashboard/user</span>
          </div>
          <h2 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 8px; color: #FFFFFF;">Member / Contributor</h2>
          <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5; margin-bottom: 16px;">
            Manage your personal profile, review portfolio publishing status, and participate in projects.
          </p>
          <div style="background: rgba(0,0,0,0.25); border: 1px dashed rgba(255,255,255,0.15); border-radius: 8px; padding: 10px; margin-bottom: 20px;">
            <div style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px;">Direct Link URL</div>
            <code style="color: #93C5FD; font-size: 0.85rem; word-break: break-all;">/any_user_login/user</code>
          </div>
        </div>
        <a href="/any_user_login/user" class="btn btn-outline-primary" style="width: 100%; text-align: center;">
          Login as Member →
        </a>
      </article>

      <!-- Public Visitor Card -->
      <article style="background: var(--bg-surface); border: 1px solid rgba(148, 163, 184, 0.3); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; position: relative; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.15);">
        <div style="position: absolute; top: 0; left: 0; right: 0; height: 4px; background: #64748B;"></div>
        <div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
            <span style="background: rgba(148, 163, 184, 0.2); color: #CBD5E1; font-size: 0.75rem; font-weight: 700; padding: 3px 10px; border-radius: 6px; text-transform: uppercase;">
              Guest Tier
            </span>
            <span style="font-size: 0.8rem; color: var(--text-muted);">/ (Home)</span>
          </div>
          <h2 style="font-size: 1.35rem; font-weight: 700; margin-bottom: 8px; color: #FFFFFF;">Public Visitor</h2>
          <p style="color: var(--text-muted); font-size: 0.9rem; line-height: 1.5; margin-bottom: 16px;">
            Clear all role credentials and browse the public website as an unauthenticated visitor.
          </p>
          <div style="background: rgba(0,0,0,0.25); border: 1px dashed rgba(255,255,255,0.15); border-radius: 8px; padding: 10px; margin-bottom: 20px;">
            <div style="font-size: 0.72rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px;">Direct Link URL</div>
            <code style="color: #CBD5E1; font-size: 0.85rem; word-break: break-all;">/any_user_login/visitor</code>
          </div>
        </div>
        <a href="/any_user_login/visitor" class="btn btn-outline-white" style="width: 100%; text-align: center;">
          Switch to Public Visitor →
        </a>
      </article>

    </div>

    <div style="text-align: center; margin-top: 40px;">
      <NavLink href="" class="btn btn-sm btn-outline-white">← Return to Homepage</NavLink>
    </div>

  </div>
</section>

