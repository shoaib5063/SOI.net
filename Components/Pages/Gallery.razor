        DescriptionEn = "Recognizing our pioneering digital audiobook library and school advocacy work across primary grades in Bangladesh.",
        DescriptionBn = "বাংলাদেশের প্রাথমিক বিদ্যালয়ের সুবিধাবঞ্চিত শিশুদের জন্য অডিওবুক লাইব্রেরী প্রতিষ্ঠার জাতীয় স্বীকৃতি।"
      },
      new GalleryItem
      {
        TitleEn = "Classroom Empathy & Interactive Inclusion Session",
