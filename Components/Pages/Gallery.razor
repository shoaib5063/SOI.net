        DescriptionEn = "Over 1,700 students have experienced our disability empathy workshop, reducing stigma and promoting peer support.",
        DescriptionBn = "১,৭০০ এর বেশি শিক্ষার্থী আমাদের এই সেশনে অংশ নিয়ে বিশেষ চাহিদাসম্পন্ন সহপাঠীদের সহায়তা করার শপথ নিয়েছে।"
      },
      new GalleryItem
      {
        TitleEn = "Voice Recording Booth: Primary Class Audiobooks",
        TitleBn = "স্টুডিওতে প্রাথমিক পাঠ্যবইয়ের ভয়েস রেকর্ডিং",
