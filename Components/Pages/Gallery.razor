        LocationDateEn = "Youth Impact Conclave • 2026",
        LocationDateBn = "ইয়ুথ ইমপ্যাক্ট কনক্লেভ • ২০২৬",
        DescriptionEn = "A milestone celebrating months of grassroots field work, school surveys, and audio engineering.",
        DescriptionBn = "কঠিন পরিশ্রম এবং স্কুল পর্যায়ের গবেষণার পর একটি ঐতিহাসিক মাইলফলক।"
      }
    };
  }
}

