        DescriptionEn = "Every lesson is recorded with accessible speed modulation and detailed auditory descriptions of visual illustrations.",
        DescriptionBn = "প্রতিটি অডিও লেসন তৈরি করা হয় বিশেষ গতি ও স্পষ্টতায় যাতে দৃষ্টিপ্রতিবন্ধী শিশু সহজেই প্রতিটি বাক্য আত্মস্থ করতে পারে।"
      },
      new GalleryItem
      {
        TitleEn = "National Fellowship Winner Celebration",
        TitleBn = "ফেলোশিপ অর্জন পরবর্তী টিম উদযাপন",
        Category = "Leadership & Community",
