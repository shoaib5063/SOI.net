        AltTextBn = "ঢাকায় ব্র্যাকের মঞ্চে স্টোরিজ অফ ইনক্লুশন প্রতিনিধিরা সম্মানিত বিচারকমণ্ডলী ও মেন্টরদের উপস্থিতিতে আমরা নতুন সোশ্যাল এন্টারপ্রেনারশিপ ফেলোশিপ ২০২৬ পুরস্কার গ্রহণ করছেন।",
        LocationDateEn = "BRAC Centre, Dhaka • October 2026",
