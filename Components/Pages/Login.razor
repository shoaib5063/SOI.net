@page "/login"
@inject AppStateService AppState
@inject NavigationManager Navigation

<PageTitle>@AppState.T("loginHeroTitle") | Stories of Inclusion</PageTitle>

<section class="section-pad auth-section">
  <div class="container auth-container">
    
    <!-- Simplified Auth Card -->
    <div class="auth-card">
      <div class="auth-card-top-plaque">
        <h2 class="auth-card-title">Welcome Back</h2>
      </div>

      <!-- Alert Box -->
      @if (!string.IsNullOrEmpty(ErrorMessage))
      {
        <div class="auth-alert error" role="alert">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span>@ErrorMessage</span>
        </div>
      }

      @if (!string.IsNullOrEmpty(SuccessMessage))
      {
        <div class="auth-alert success" role="alert">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>@SuccessMessage</span>
        </div>
      }

      <!-- Main Login Form -->
      <EditForm Model="@LoginModel" OnValidSubmit="HandleLogin" class="auth-form">
        <DataAnnotationsValidator />

        <!-- Social Sign-in Options -->
        <div class="auth-social-buttons">
          <button type="button" class="btn-social-auth" @onclick="LoginWithGoogle" disabled="@IsLoading" aria-label="Sign in with Google">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.66v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.15z"/>
              <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.27v3.15C3.25 21.31 7.31 24 12 24z"/>
              <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.27C.46 8.2.01 10.04.01 12c0 1.96.45 3.8 1.26 5.42l4.01-3.15z"/>
              <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.25 2.69 1.27 6.58l4.01 3.15c.95-2.83 3.6-4.98 6.72-4.98z"/>
            </svg>
            <span>Google</span>
          </button>
          <button type="button" class="btn-social-auth" @onclick="LoginWithFacebook" disabled="@IsLoading" aria-label="Sign in with Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#1877F2" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>Facebook</span>
          </button>
        </div>

        <div class="auth-divider" aria-hidden="true">
          <span>or</span>
        </div>

        <div class="form-group">
          <label for="login-email" class="form-label">Email</label>
          <div class="input-with-icon">
            <span class="input-lead-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </span>
            <InputText id="login-email" 
                       type="email" 
                       class="form-input" 
                       @bind-Value="LoginModel.Email" 
                       placeholder="name@example.com" 
                       required 
                       aria-required="true" />
          </div>
          <ValidationMessage For="@(() => LoginModel.Email)" class="validation-msg" />
        </div>

        <div class="form-group">
          <div class="label-row-between">
            <label for="login-password" class="form-label">Password</label>
            <NavLink href="forgot-password" class="auth-inline-link">Forgot Password?</NavLink>
          </div>
          <div class="input-with-icon">
            <span class="input-lead-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            </span>
            <InputText id="login-password" 
                       type="@(ShowPassword ? "text" : "password")" 
                       class="form-input" 
                       @bind-Value="LoginModel.Password" 
                       placeholder="••••••••" 
                       required 
                       aria-required="true" />
            <button type="button" 
                    class="input-trailing-btn" 
                    @onclick="TogglePasswordVisibility" 
                    aria-label="@(ShowPassword ? "Hide password" : "Show password")">
              @if (ShowPassword)
              {
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>
              }
              else
              {
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              }
            </button>
          </div>
          <ValidationMessage For="@(() => LoginModel.Password)" class="validation-msg" />
        </div>

        <div class="form-row-remember">
          <label class="custom-checkbox-label">
            <InputCheckbox @bind-Value="LoginModel.RememberMe" class="custom-checkbox" />
            <span>Remember me</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-auth-submit" disabled="@IsLoading">
          @if (IsLoading)
          {
            <span class="auth-spinner" aria-hidden="true"></span>
            <span>Signing in...</span>
          }
          else
          {
            <span>Sign In</span>
          }
        </button>
      </EditForm>

      <div class="auth-card-footer">
        <span>Don't have an account?</span>
        <NavLink href="register" class="auth-register-link">Register</NavLink>
      </div>
    </div>

  </div>
</section>
