@page "/dashboard/superadmin"
@rendermode InteractiveServer
@inject AppStateService AppState

<PageTitle>SuperAdmin Console | Stories of Inclusion</PageTitle>

<div class="dash-container">
  <!-- Sidebar -->
  <aside class="dash-sidebar" aria-label="SuperAdmin Navigation">
    <div class="dash-user-card">
      <div class="dash-avatar" style="background:#7C3AED;">SA</div>
      <div>
        <div class="dash-user-name">Iffat Nusaiba</div>
        <span class="dash-role-tag" style="background:rgba(124,58,237,0.25); color:#C4B5FD;">SuperAdmin</span>
      </div>
    </div>

    <ul class="dash-nav">
      <li>
        <button type="button" class="dash-nav-link @(ActiveTab == "users" ? "active" : "")" @onclick="@(() => ActiveTab = "users")">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          <span>User Roles & Access</span>
        </button>
      </li>
      <li>
        <button type="button" class="dash-nav-link @(ActiveTab == "logs" ? "active" : "")" @onclick="@(() => ActiveTab = "logs")">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          <span>System Audit Logs</span>
        </button>
      </li>
      <li>
        <button type="button" class="dash-nav-link @(ActiveTab == "database" ? "active" : "")" @onclick="@(() => ActiveTab = "database")">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
          <span>Database & Storage</span>
        </button>
      </li>
      <li>
        <button type="button" class="dash-nav-link @(ActiveTab == "admin-guide" ? "active" : "")" @onclick="@(() => ActiveTab = "admin-guide")">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          <span>Short Admin Guide</span>
        </button>
      </li>
      <li style="margin-top:10px; border-top:1px solid rgba(255,255,255,0.1); padding-top:10px;">
        <NavLink href="" class="dash-nav-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
          <span>Public Website</span>
        </NavLink>
      </li>
    </ul>

    <div style="margin-top:auto; padding-top:20px; border-top:1px solid rgba(255,255,255,0.15);">
      <small style="color:#94A3B8;">PostgreSQL RLS: <strong style="color:#22C55E;">Enforced & Secure</strong></small>
    </div>
  </aside>

  <!-- Main Content Area -->
  <main class="dash-main" role="main">
    <div class="dash-header-bar">
      <div>
        <h1 class="dash-title">SuperAdmin Control Console</h1>
        <p style="color:var(--text-muted); font-size:0.95rem;">Full administrative governance: manage user roles, inspect audit logs, and access the official Admin Guide.</p>
      </div>
      <div style="display:flex; gap:10px;">
        <button type="button" class="btn btn-primary btn-sm" @onclick="ToggleAddUserModal">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Add New User</span>
        </button>
        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="PingDatabase">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
          <span>@(IsPinging ? "Checking..." : "Ping Supabase DB")</span>
        </button>
      </div>
    </div>

    @if (DbPingResult != null)
    {
      <div class="form-success-alert" style="display:block; margin-bottom:20px;">
        @DbPingResult
      </div>
    }

    @if (ShowAlert)
    {
      <div class="form-success-alert" style="display:block; margin-bottom:20px;">
        @AlertMessage
      </div>
    }

    <!-- Add User Modal / Panel -->
    @if (IsAddUserOpen)
    {
      <div class="dash-card" style="border:2px solid var(--color-accent-teal); margin-bottom:28px; background:rgba(20,184,166,0.03);">
        <div class="dash-card-header">
          <h3>Create & Provision New User Account</h3>
          <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ToggleAddUserModal">Cancel</button>
        </div>
        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap:16px; margin-bottom:16px;">
          <div>
            <label class="form-label">Full Name</label>
            <input type="text" class="form-input" @bind="NewUserName" placeholder="e.g. Nusrat Jahan" />
          </div>
          <div>
            <label class="form-label">Email Address</label>
            <input type="email" class="form-input" @bind="NewUserEmail" placeholder="e.g. nusrat@example.com" />
          </div>
          <div>
            <label class="form-label">Assign Role</label>
            <select class="form-input" @bind="NewUserRole">
              <option value="user">User (Member)</option>
              <option value="admin">Staff Admin</option>
              <option value="superadmin">SuperAdmin</option>
            </select>
          </div>
        </div>
        <button type="button" class="btn btn-primary btn-sm" @onclick="CreateUser">Save & Add Account</button>
      </div>
    }

    <!-- System KPIs -->
    <div class="dash-stats-grid">
      <div class="dash-stat-card">
        <div class="dash-stat-info">
          <h3>@Users.Count</h3>
          <p>Total Registered Users</p>
        </div>
        <div class="dash-stat-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        </div>
      </div>

      <div class="dash-stat-card">
        <div class="dash-stat-info">
          <h3>@AdminCount</h3>
          <p>Active Staff Admins</p>
        </div>
        <div class="dash-stat-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </div>
      </div>

      <div class="dash-stat-card">
        <div class="dash-stat-info">
          <h3 style="color:#15803D;">Connected</h3>
          <p>Supabase Postgres</p>
        </div>
        <div class="dash-stat-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
        </div>
      </div>

      <div class="dash-stat-card">
        <div class="dash-stat-info">
          <h3>14.8 MB</h3>
          <p>Storage Used (1 GB Free)</p>
        </div>
        <div class="dash-stat-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path></svg>
        </div>
      </div>
    </div>

    <!-- TAB 1: USER MANAGEMENT -->
    @if (ActiveTab == "users")
    {
      <section class="dash-card">
        <div class="dash-card-header" style="flex-wrap:wrap; gap:14px;">
          <div>
            <h3>User Management: Roles & Privilege Control</h3>
            <p style="color:var(--text-muted); font-size:0.875rem; margin:0;">SuperAdmins can change any user's role or permanently revoke access.</p>
          </div>
          
          <!-- Search & Filter Controls -->
          <div style="display:flex; gap:10px; flex-wrap:wrap; align-items:center;">
            <input type="text" class="form-input" style="width:200px; padding:6px 12px; font-size:0.875rem;" placeholder="Search name/email..." @bind="SearchQuery" @bind:event="oninput" />
            
            <select class="form-input" style="width:140px; padding:6px 10px; font-size:0.875rem;" @bind="RoleFilter">
              <option value="all">All Roles</option>
              <option value="superadmin">SuperAdmin</option>
              <option value="admin">Staff Admin</option>
              <option value="user">Member (User)</option>
            </select>
          </div>
        </div>

        <div class="table-responsive"><table class="dash-table">
          <thead>
            <tr>
              <th>User / Name</th>
              <th>Email</th>
              <th>Current Role</th>
              <th>Assign New Role</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            @if (FilteredUsers.Count == 0)
            {
              <tr>
                <td colspan="5" style="text-align:center; padding:24px; color:var(--text-muted);">
                  No users found matching your search criteria.
                </td>
              </tr>
            }
            @foreach (var u in FilteredUsers)
            {
              <tr>
                <td><strong>@u.Name</strong></td>
                <td>@u.Email</td>
                <td>
                  <span class="dash-role-tag" style="background:@(u.Role == "superadmin" ? "rgba(124,58,237,0.2)" : u.Role == "admin" ? "rgba(37,99,235,0.2)" : "rgba(13,148,136,0.2)"); color:@(u.Role == "superadmin" ? "#7C3AED" : u.Role == "admin" ? "#2563EB" : "#0D9488");">
                    @u.Role.ToUpper()
                  </span>
                </td>
                <td>
                  <select value="@u.Role" @onchange="(e) => ChangeUserRole(u, e.Value?.ToString())" style="padding:6px 10px; border-radius:var(--radius-sm); border:1px solid var(--border-color); font-weight:600; font-size:0.875rem;">
                    <option value="user">User (Member)</option>
                    <option value="admin">Staff Admin</option>
                    <option value="superadmin">SuperAdmin</option>
                  </select>
                </td>
                <td>
                  <button type="button" class="btn btn-danger btn-sm" @onclick="() => RevokeUser(u)">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    <span>Revoke</span>
                  </button>
                </td>
              </tr>
            }
          </tbody>
        </table></div>
      </section>
    }

    <!-- TAB 2: AUDIT LOGS -->
    @if (ActiveTab == "logs")
    {
      <section class="dash-card">
        <div class="dash-card-header">
          <div>
            <h3>Security & Role Audit Log</h3>
            <p style="color:var(--text-muted); font-size:0.875rem; margin:0;">Real-time chronological record of administrative actions and permission changes.</p>
          </div>
          <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ClearAuditLogs">Clear Log</button>
        </div>

        <div class="table-responsive"><table class="dash-table">
          <thead>
            <tr>
              <th>Timestamp</th>
              <th>Actor</th>
              <th>Event / Action</th>
              <th>Severity</th>
            </tr>
          </thead>
          <tbody>
            @if (AuditLogs.Count == 0)
            {
              <tr>
                <td colspan="4" style="text-align:center; padding:24px; color:var(--text-muted);">
                  Audit logs cleared.
                </td>
              </tr>
            }
            @foreach (var log in AuditLogs)
            {
              <tr>
                <td><small style="color:var(--text-muted);">@log.Timestamp</small></td>
                <td><strong>@log.Actor</strong></td>
                <td>@log.Event</td>
                <td>
                  <span class="badge-status @(log.Severity == "Warning" ? "new" : "approved")">@log.Severity</span>
                </td>
              </tr>
            }
          </tbody>
        </table></div>
      </section>
    }

    <!-- TAB 3: DATABASE & STORAGE -->
    @if (ActiveTab == "database")
    {
      <section class="dash-card">
        <div class="dash-card-header">
          <h3>Supabase PostgreSQL Database & Storage Pools</h3>
        </div>
        
        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap:20px; margin-bottom:24px;">
          <div style="background:var(--bg-primary); padding:20px; border-radius:12px; border:1px solid var(--border-color);">
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
              <h4 style="margin:0;">PostgreSQL Tables</h4>
            </div>
            <ul style="margin:0; padding-left:20px; line-height:2; color:var(--text-muted);">
              <li><strong>public.profiles:</strong> @Users.Count rows</li>
              <li><strong>public.form_submissions:</strong> 6 rows</li>
              <li><strong>public.audiobooks:</strong> 4 rows</li>
            </ul>
          </div>

          <div style="background:var(--bg-primary); padding:20px; border-radius:12px; border:1px solid var(--border-color);">
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path></svg>
              <h4 style="margin:0;">Storage Buckets</h4>
            </div>
            <ul style="margin:0; padding-left:20px; line-height:2; color:var(--text-muted);">
              <li><strong>audiobooks:</strong> 3 MP3 files (14.2 MB)</li>
              <li><strong>covers:</strong> 4 JPG images (620 KB)</li>
              <li><strong>Available Free Quota:</strong> 985.2 MB remaining</li>
            </ul>
          </div>
        </div>

        <button type="button" class="btn btn-primary btn-sm" @onclick="PingDatabase">Re-check System Health</button>
      </section>
    }

    <!-- TAB 4: SHORT ADMIN GUIDE (DELIVERABLE #14) -->
    @if (ActiveTab == "admin-guide")
    {
      <section class="dash-card admin-guide-card">
        <div class="dash-card-header" style="border-bottom: 2px solid var(--border-color); padding-bottom: 18px; margin-bottom: 24px;">
          <div>
            <div style="display:inline-flex; align-items:center; gap:6px; background:rgba(124,58,237,0.12); color:#7C3AED; padding:3px 10px; border-radius:9999px; font-size:0.75rem; font-weight:800; margin-bottom:8px;">
              <span>Executive Manual</span> • <span>Deliverable #14</span>
            </div>
            <h2 style="font-size:1.6rem; font-weight:800; margin:0 0 6px 0; color:var(--color-navy-dark);">SuperAdmin & Executive Director Governance Guide</h2>
            <p style="color:var(--text-muted); font-size:0.925rem; margin:0; line-height:1.6;">
              Strategic platform governance guide for Executive Director <strong>Iffat Nusaiba</strong> and developer <strong>Shoaib Ahmed</strong> under Section 3 & 5.5 of the Agreement.
            </p>
          </div>
          <button type="button" class="btn btn-outline-primary btn-sm" onclick="window.print()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
            <span>Print Guide (PDF)</span>
          </button>
        </div>

        <div class="admin-guide-chapters">
          
          <article class="guide-chapter-box">
            <div class="guide-chapter-badge">Chapter 1</div>
            <h3 class="guide-chapter-title">Role-Based Access Control (RBAC) Governance</h3>
            <p class="guide-chapter-desc">
              The platform enforces 3 security tiers: <code>user</code> (Member), <code>admin</code> (Staff Coordinator), and <code>superadmin</code> (Executive Director).
            </p>
            <ol class="guide-steps-list">
              <li><strong>Promoting Coordinators:</strong> Go to the <em>User Roles & Access</em> tab, search by email, and choose <strong>Staff Admin</strong> from the dropdown.</li>
              <li><strong>Revoking Access:</strong> If a volunteer leaves, click <strong>Revoke</strong> to safely decommission their credentials.</li>
              <li><strong>Audit Trail:</strong> Every elevation or role switch is logged chronologically in the <em>System Audit Logs</em> tab.</li>
            </ol>
          </article>

          <article class="guide-chapter-box">
            <div class="guide-chapter-badge">Chapter 2</div>
            <h3 class="guide-chapter-title">Platform Maintenance & Database Health</h3>
            <p class="guide-chapter-desc">
              All records, portfolios, and submissions are stored in Supabase PostgreSQL with Row Level Security (RLS).
            </p>
            <ol class="guide-steps-list">
              <li><strong>Health Checks:</strong> Use <strong>Ping Supabase DB</strong> to verify connection latency and pool status.</li>
              <li><strong>Quota Management:</strong> Audiobooks use YouTube streaming to maintain virtually 0 MB server storage load, preserving the 1 GB database free tier indefinitely.</li>
            </ol>
          </article>

          <article class="guide-chapter-box" style="border-left-color: #22C55E;">
            <div class="guide-chapter-badge" style="background: rgba(34,197,94,0.15); color: #15803D;">Chapter 3</div>
            <h3 class="guide-chapter-title">WCAG 2.1 Level AA Platform Conformance Guarantee</h3>
            <p class="guide-chapter-desc">
              In accordance with Section 15 of the Agreement, maintain 100% WCAG 2.1 Level AA compliance before announcing public launches or campaigns.
            </p>
            <div class="guide-checklist-grid">
              <div class="guide-check-card">
                <div class="guide-check-icon">✓</div>
                <div><strong>4.5:1 Text Contrast</strong> across light, dark, and high-contrast modes.</div>
              </div>
              <div class="guide-check-card">
                <div class="guide-check-icon">✓</div>
                <div><strong>Full Keyboard & Screen Reader Access</strong> via skip links, ARIA live regions, and semantic landmarks.</div>
              </div>
            </div>
          </article>

        </div>
      </section>
    }

  </main>
</div>
