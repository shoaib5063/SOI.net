@page "/dashboard/user"
@rendermode InteractiveServer
@inject AppStateService AppState
@inject NavigationManager Navigation

<PageTitle>Member Dashboard | Stories of Inclusion</PageTitle>

<div class="dash-container">
  <!-- Sidebar -->
  <aside class="dash-sidebar" aria-label="Member Navigation">
    <div class="dash-user-card">
      <div class="dash-avatar">@GetInitials(ProfileModel.FullName)</div>
      <div>
        <div class="dash-user-name">@ProfileModel.FullName</div>
        <span class="dash-role-tag">Member (User)</span>
      </div>
    </div>

    <ul class="dash-nav">
      <li>
        <button type="button" class="dash-nav-link @(ActiveTab == "profile" ? "active" : "")" @onclick="@(() => ActiveTab = "profile")">
          <span>👤</span> <span>My Profile & Bio</span>
        </button>
      </li>
      <li>
        <button type="button" class="dash-nav-link @(ActiveTab == "showcase" ? "active" : "")" @onclick="@(() => ActiveTab = "showcase")">
          <span>🎨</span> <span>My Works (@ContributedWorks.Count)</span>
        </button>
      </li>
      <li>
        <button type="button" class="dash-nav-link @(ActiveTab == "submit" ? "active" : "")" @onclick="@(() => ActiveTab = "submit")">
          <span>➕</span> <span>Submit Contribution</span>
        </button>
      </li>
      <li style="margin-top:10px; border-top:1px solid rgba(255,255,255,0.1); padding-top:10px;">
        <NavLink href="" class="dash-nav-link">
          <span>🌐</span> <span>Public Website</span>
        </NavLink>
      </li>
    </ul>

    <div style="margin-top:auto; padding-top:20px; border-top:1px solid rgba(255,255,255,0.15);">
      <small style="color:#94A3B8;">Status: <strong style="color:#2DD4BF;">Verified Member</strong></small>
    </div>
  </aside>

  <!-- Main Content Area -->
  <main class="dash-main" role="main">
    <div class="dash-header-bar">
      <div>
        <h1 class="dash-title">Member Portfolio Dashboard</h1>
        <p style="color:var(--text-muted); font-size:0.95rem;">Manage your public portfolio, update your biographical story, and submit learning works.</p>
      </div>
      <div>
        <NavLink href="team" class="btn btn-outline-primary btn-sm">Preview Public Team Page ↗</NavLink>
      </div>
    </div>

    @if (ShowAlert)
    {
      <div class="form-success-alert" style="display:block; margin-bottom:20px;">
        @AlertMessage
      </div>
    }

    <!-- Stats -->
    <div class="dash-stats-grid">
      <div class="dash-stat-card">
        <div class="dash-stat-info">
          <h3>@(ProfileModel.IsPortfolioApproved ? "Approved" : "Pending")</h3>
          <p>Portfolio Status</p>
        </div>
        <div class="dash-stat-icon">✅</div>
      </div>

      <div class="dash-stat-card">
        <div class="dash-stat-info">
          <h3>@ContributedWorks.Count</h3>
          <p>Active Works Contributed</p>
        </div>
        <div class="dash-stat-icon">📚</div>
      </div>

      <div class="dash-stat-card">
        <div class="dash-stat-info">
          <h3>1,700+</h3>
          <p>Students Impacted</p>
        </div>
        <div class="dash-stat-icon">🌟</div>
      </div>
    </div>

    <!-- TAB 1: EDIT PROFILE -->
    @if (ActiveTab == "profile")
    {
      <section class="dash-card">
        <div class="dash-card-header">
          <div>
            <h3>Personal Details & Public Biography</h3>
            <p style="color:var(--text-muted); font-size:0.875rem; margin:0;">Keep your name, contact details, and bilingual bio up to date for public showcase.</p>
          </div>
          <span class="badge-status approved">Approved & Live</span>
        </div>

        <EditForm Model="@ProfileModel" OnValidSubmit="HandleSaveProfile">
          <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap:20px; margin-bottom:20px;">
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label">Full Name</label>
              <InputText class="form-input" @bind-Value="ProfileModel.FullName" required />
            </div>

            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label">Email Address</label>
              <InputText class="form-input" @bind-Value="ProfileModel.Email" required />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Biography (English)</label>
            <InputTextArea class="form-textarea" rows="3" @bind-Value="ProfileModel.BioEn" />
          </div>

          <div class="form-group">
            <label class="form-label">Biography (বাংলা)</label>
            <InputTextArea class="form-textarea" rows="3" @bind-Value="ProfileModel.BioBn" />
          </div>

          <button type="submit" class="btn btn-primary">Save Profile Changes</button>
        </EditForm>
      </section>
    }

    <!-- TAB 2: PORTFOLIO SHOWCASE -->
    @if (ActiveTab == "showcase")
    {
      <section class="dash-card">
        <div class="dash-card-header">
          <div>
            <h3>My Portfolio Projects & Audio Contributions</h3>
            <p style="color:var(--text-muted); font-size:0.875rem; margin:0;">Educational resources and empathy programs you have contributed to.</p>
          </div>
          <button type="button" class="btn btn-primary btn-sm" @onclick="@(() => ActiveTab = "submit")">
            ➕ Add New Project
          </button>
        </div>

        <div class="table-responsive"><table class="dash-table">
          <thead>
            <tr>
              <th>Project Title</th>
              <th>Category</th>
              <th>Date Added</th>
              <th>Review Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            @if (ContributedWorks.Count == 0)
            {
              <tr>
                <td colspan="5" style="text-align:center; padding:24px; color:var(--text-muted);">
                  You have not submitted any contributions yet.
                </td>
              </tr>
            }
            @foreach (var work in ContributedWorks)
            {
              <tr>
                <td><strong>@work.Title</strong></td>
                <td>@work.Category</td>
                <td>@work.Date</td>
                <td><span class="badge-status @(work.Status == "Published" ? "approved" : "pending")">@work.Status</span></td>
                <td>
                  <button type="button" class="btn btn-danger btn-sm" @onclick="() => DeleteWork(work)">Remove</button>
                </td>
              </tr>
            }
          </tbody>
        </table></div>
      </section>
    }

    <!-- TAB 3: SUBMIT WORK -->
    @if (ActiveTab == "submit")
    {
      <section class="dash-card">
        <div class="dash-card-header">
          <div>
            <h3>Submit New Audiobook / Activity Contribution</h3>
            <p style="color:var(--text-muted); font-size:0.875rem; margin:0;">Submit your voice recording sample, lesson plan, or workshop summary for staff approval.</p>
          </div>
        </div>

        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap:20px; margin-bottom:20px;">
          <div class="form-group" style="margin-bottom:0;">
            <label class="form-label">Project Title</label>
            <input type="text" class="form-input" @bind="NewWorkTitle" placeholder="e.g. Primary Class 3 Bangla Audio Story" />
          </div>

          <div class="form-group" style="margin-bottom:0;">
            <label class="form-label">Category</label>
            <select class="form-input" @bind="NewWorkCategory">
              <option value="Audiobook Production">Audiobook Production (Voice Artist)</option>
              <option value="Offline Workshop">Offline School Workshop</option>
              <option value="Braille Digitization">Braille & Assistive Tech Content</option>
              <option value="Lesson Material">Accessible Lesson Worksheets</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">YouTube Video Link (Streaming URL)</label>
          <input type="url" class="form-input" @bind="NewWorkYouTubeUrl" placeholder="https://www.youtube.com/watch?v=... or https://youtu.be/..." />
          <small style="color:var(--text-muted);">Audiobooks stream directly from YouTube inside the player without file storage.</small>
        </div>

        <div class="form-group">
          <label class="form-label">Submission Details & Notes</label>
          <textarea class="form-textarea" rows="3" @bind="NewWorkDescription" placeholder="Provide description, target grade level, or extra notes..."></textarea>
        </div>

        <button type="button" class="btn btn-primary" @onclick="SubmitNewWork">Submit for Staff Verification</button>
      </section>
    }

  </main>
</div>


