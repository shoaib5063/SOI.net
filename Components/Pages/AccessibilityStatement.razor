@page "/accessibility"
@inject AppStateService AppState

<PageTitle>WCAG 2.1 AA Accessibility Statement | Stories of Inclusion</PageTitle>

<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><NavLink href="">Home</NavLink></li>
        <li class="breadcrumb-separator" aria-hidden="true">/</li>
        <li aria-current="page">Accessibility Statement</li>
      </ol>
    </nav>
    <div class="sdg-badge-wrap" style="margin-bottom:14px;">
      <span aria-hidden="true">♿</span>
      <span>Official Compliance Statement • W3C WCAG 2.1 Level AA</span>
    </div>
    <h1 class="page-hero-title">Accessibility Statement</h1>
    <p class="page-hero-desc">Stories of Inclusion is dedicated to ensuring digital access for people with disabilities, blind and low-vision learners, and neurodivergent individuals.</p>
  </div>
</section>

<section class="section-pad">
  <div class="container" style="max-width:880px; margin:0 auto;">
    <div class="contact-card" style="padding:48px 40px;">
      <span class="badge-winner" style="margin-bottom:16px;">Audited Standard: WCAG 2.1 Level AA & Level AAA Elements</span>

      <h2 style="font-size:1.5rem; color:var(--color-navy-dark); margin:20px 0 10px;">Our Conformance Commitment</h2>
      <p style="color:var(--text-muted); line-height:1.7; margin-bottom:18px;">
        This website is engineered according to the Web Content Accessibility Guidelines (WCAG) 2.1 Level AA standards established by the World Wide Web Consortium (W3C).
      </p>

      <div class="pillars-grid-6" style="margin:24px 0;">
        <div class="pillar-card-6">
          <h4 style="font-size:1.05rem; margin-bottom:6px;">Descriptive Alt Text</h4>
          <p style="font-size:0.875rem;">Every photograph, logo, and illustration carries human-verified contextual descriptions for screen readers.</p>
        </div>
        <div class="pillar-card-6">
          <h4 style="font-size:1.05rem; margin-bottom:6px;">Tactile Contrast Ratios</h4>
          <p style="font-size:0.875rem;">All text meets or exceeds the required 4.5:1 contrast ratio (and 7:1 in High Contrast mode).</p>
        </div>
        <div class="pillar-card-6">
          <h4 style="font-size:1.05rem; margin-bottom:6px;">Full Keyboard Navigation</h4>
          <p style="font-size:0.875rem;">Every control, modal, drawer, and link can be operated completely via Tab, Space, Enter, and Escape keys.</p>
        </div>
        <div class="pillar-card-6">
          <h4 style="font-size:1.05rem; margin-bottom:6px;">Audio Transcripts</h4>
          <p style="font-size:0.875rem;">All audiobooks, vlog videos, and blog media include verbatim spoken transcripts.</p>
        </div>
        <div class="pillar-card-6">
          <h4 style="font-size:1.05rem; margin-bottom:6px;">Dyslexia-Friendly Type</h4>
          <p style="font-size:0.875rem;">Built-in one-click toggle to transform all copy into specialized weighted letterforms.</p>
        </div>
        <div class="pillar-card-6">
          <h4 style="font-size:1.05rem; margin-bottom:6px;">Bilingual Localization</h4>
          <p style="font-size:0.875rem;">Zero-lag instant switching between English and Bengali across all interfaces.</p>
        </div>
      </div>

      <h2 style="font-size:1.5rem; color:var(--color-navy-dark); margin:20px 0 10px;">Accessibility Feedback & Technical Inquiries</h2>
      <p style="color:var(--text-muted); line-height:1.7;">
        We welcome your input! If you encounter any barrier while browsing with assistive technology, please notify our Lead Developer & Accessibility Architect:
        <br />
        <strong>Shoaib Ahmed:</strong> <a href="mailto:shoaibahmed.5063@gmail.com" style="color:var(--color-accent-teal); font-weight:700;">shoaibahmed.5063@gmail.com</a>
        <br />
        <strong>Organization:</strong> <a href="mailto:storiesofinclusion.bd@gmail.com" style="color:var(--color-accent-teal); font-weight:700;">storiesofinclusion.bd@gmail.com</a>
      </p>
    </div>
  </div>
</section>

