@page "/terms"
@inject AppStateService AppState

<PageTitle>Terms of Use | Stories of Inclusion</PageTitle>

<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><NavLink href="">Home</NavLink></li>
        <li class="breadcrumb-separator" aria-hidden="true">/</li>
        <li aria-current="page">Terms of Service</li>
      </ol>
    </nav>
    <h1 class="page-hero-title">Terms of Service</h1>
    <p class="page-hero-desc">Terms governing the use of educational materials, audiobooks, and publications provided by Stories of Inclusion.</p>
  </div>
</section>

<section class="section-pad">
  <div class="container" style="max-width:860px; margin:0 auto;">
    <div class="contact-card" style="padding:48px 40px;">
      <h2 style="font-size:1.5rem; color:var(--color-navy-dark); margin:0 0 10px;">1. Open Educational Access</h2>
      <p style="color:var(--text-muted); line-height:1.7; margin-bottom:18px;">
        All primary audiobooks, transcripts, and magazine publications published on Stories of Inclusion are provided completely free of charge for non-commercial educational use by children, parents, teachers, and schools.
      </p>

      <h2 style="font-size:1.5rem; color:var(--color-navy-dark); margin:20px 0 10px;">2. Intellectual Property & Attribution</h2>
      <p style="color:var(--text-muted); line-height:1.7; margin-bottom:18px;">
        Audiobook narration tracks, tactile illustrations, and magazine essays produced by Stories of Inclusion are protected under Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International (CC BY-NC-SA 4.0). You may freely share and adapt the material provided appropriate attribution is maintained.
      </p>

      <h2 style="font-size:1.5rem; color:var(--color-navy-dark); margin:20px 0 10px;">3. Store & Social Enterprise Disclaimer</h2>
      <p style="color:var(--text-muted); line-height:1.7;">
        All merchandise and learning kits available through our store operate strictly on a 100% non-profit reinvestment model to subsidize accessible school tools for underprivileged students.
      </p>
    </div>
  </div>
</section>

