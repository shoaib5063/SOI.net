@page "/privacy"
@inject AppStateService AppState

<PageTitle>Privacy Policy | Stories of Inclusion</PageTitle>

<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><NavLink href="">Home</NavLink></li>
        <li class="breadcrumb-separator" aria-hidden="true">/</li>
        <li aria-current="page">Privacy Policy</li>
      </ol>
    </nav>
    <h1 class="page-hero-title">Privacy Policy</h1>
    <p class="page-hero-desc">How Stories of Inclusion collects, protects, and manages data in compliance with international accessibility and data confidentiality standards.</p>
  </div>
</section>

<section class="section-pad">
  <div class="container" style="max-width:860px; margin:0 auto;">
    <div class="contact-card" style="padding:48px 40px;">
      <span class="badge-winner" style="margin-bottom:16px;">Effective Date: 15 October 2026</span>

      <h2 style="font-size:1.5rem; color:var(--color-navy-dark); margin:20px 0 10px;">1. Data Ownership and Confidentiality</h2>
      <p style="color:var(--text-muted); line-height:1.7; margin-bottom:18px;">
        Stories of Inclusion is the sole controller of information gathered on this website, including Contact and Join Us submissions. We will never sell, lease, or monetize your contact details to third parties.
      </p>

      <h2 style="font-size:1.5rem; color:var(--color-navy-dark); margin:20px 0 10px;">2. Accessibility & User Preferences Storage</h2>
      <p style="color:var(--text-muted); line-height:1.7; margin-bottom:18px;">
        We store your accessibility preferences (e.g. high contrast theme, font scale percentage, and dyslexia font mode) in your local browser session to guarantee a seamless reading experience across visits. No personal identifying information is attached to these aesthetic settings.
      </p>

      <h2 style="font-size:1.5rem; color:var(--color-navy-dark); margin:20px 0 10px;">3. Security Safeguards</h2>
      <p style="color:var(--text-muted); line-height:1.7; margin-bottom:18px;">
        As outlined in our developer agreement, all website interactions are protected using TLS/HTTPS encryption, strict input validation, and secure cryptographic password hashing for administrative access.
      </p>

      <h2 style="font-size:1.5rem; color:var(--color-navy-dark); margin:20px 0 10px;">4. Inquiries & Data Removal</h2>
      <p style="color:var(--text-muted); line-height:1.7;">
        To review, update, or request the deletion of your volunteer submission data, please email us directly at:
        <a href="mailto:storiesofinclusion.bd@gmail.com" style="color:var(--color-accent-teal); font-weight:700;">storiesofinclusion.bd@gmail.com</a>.
      </p>
    </div>
  </div>
</section>

