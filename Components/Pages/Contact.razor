@page "/contact"
@inject AppStateService AppState

<PageTitle>Get Involved & Contact | Stories of Inclusion</PageTitle>

<section class="page-hero" aria-labelledby="page-title">
  <div class="container">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><NavLink href="">@AppState.T("homeBreadcrumb")</NavLink></li>
        <li class="breadcrumb-separator" aria-hidden="true">/</li>
        <li aria-current="page">@AppState.T("navJoin")</li>
      </ol>
    </nav>
    <h1 id="page-title" class="page-hero-title">@AppState.T("contactHeroTitle")</h1>
    <p class="page-hero-desc">@AppState.T("contactHeroDesc")</p>
  </div>
</section>

<section class="section-pad">
  <div class="container">
    <div class="contact-grid">
      
      <!-- Contact Info Card -->
      <div class="contact-info-card">
        <h2 style="font-size:1.6rem; color:var(--color-navy-dark); margin-bottom:20px;">@AppState.T("contactInfoTitle")</h2>
        
        <div style="margin-bottom:20px;">
          <strong style="display:block; color:var(--color-accent-teal); font-size:0.875rem;">Headquarters Address:</strong>
          <p style="font-size:1.05rem;">@(AppState.CurrentLanguage == "bn" ? "ঢাকা, বাংলাদেশ" : "Dhaka, BD")</p>
        </div>

        <div style="margin-bottom:20px;">
          <strong style="display:block; color:var(--color-accent-teal); font-size:0.875rem;">Phone / WhatsApp:</strong>
          <p style="font-size:1.05rem;">+880 1914-015054</p>
        </div>

        <div style="margin-bottom:24px;">
          <strong style="display:block; color:var(--color-accent-teal); font-size:0.875rem;">Email Address:</strong>
          <p style="font-size:1.05rem;">storiesofinclusion.bd@gmail.com</p>
        </div>

        <div style="border-top:1px solid var(--border-color); padding-top:20px;">
          <strong style="display:block; color:var(--text-main); font-size:0.925rem; margin-bottom:12px;">Official Channels:</strong>
          <ul style="list-style:none; display:flex; flex-direction:column; gap:10px; font-weight:600; font-size:0.925rem; padding-left:0;">
            <li style="display:flex; align-items:center; gap:8px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color:var(--color-navy-mid);" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
              <a href="https://www.facebook.com/storiesofinclusion.bd" target="_blank" rel="noopener noreferrer" style="color:var(--color-navy-mid); text-decoration:none;">Facebook: storiesofinclusion.bd</a>
            </li>
            <li style="display:flex; align-items:center; gap:8px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color:#E11D48;" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="#fff"/></svg>
              <a href="https://www.youtube.com/@@stories_of_inclusion" target="_blank" rel="noopener noreferrer" style="color:#E11D48; text-decoration:none;">YouTube: @@stories_of_inclusion</a>
            </li>
            <li style="display:flex; align-items:center; gap:8px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:#C13584;" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              <a href="https://www.instagram.com/storiesofinclusion" target="_blank" rel="noopener noreferrer" style="color:#C13584; text-decoration:none;">Instagram: storiesofinclusion</a>
            </li>
            <li style="display:flex; align-items:center; gap:8px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color:#0A66C2;" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              <a href="https://www.linkedin.com/company/stories-of-inclusion" target="_blank" rel="noopener noreferrer" style="color:#0A66C2; text-decoration:none;">LinkedIn: Stories of Inclusion</a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Application Form -->
      <div class="contact-card">
        @if (IsSubmitted)
        {
          <div class="form-success-alert" role="alert" style="display:block;">
            Thank you! Your submission has been received. Our team will contact you shortly.
          </div>
        }

        <EditForm Model="@SubmissionModel" OnValidSubmit="HandleSubmit">
          <DataAnnotationsValidator />
          
          <div class="form-group">
            <label for="form-type" class="form-label">I Want To:</label>
            <InputSelect id="form-type" class="form-select" @bind-Value="SubmissionModel.SubmissionType">
              <option value="Join Us">Join as Volunteer / Contributor</option>
              <option value="Contact Inquiry">General Inquiry / School Partnership</option>
            </InputSelect>
          </div>

          <div class="form-group">
            <label for="form-name" class="form-label">Full Name *</label>
            <InputText id="form-name" class="form-input" @bind-Value="SubmissionModel.FullName" required />
            <ValidationMessage For="@(() => SubmissionModel.FullName)" />
          </div>

          <div class="form-group">
            <label for="form-email" class="form-label">Email Address *</label>
            <InputText id="form-email" type="email" class="form-input" @bind-Value="SubmissionModel.Email" required />
            <ValidationMessage For="@(() => SubmissionModel.Email)" />
          </div>

          <div class="form-group">
            <label for="form-phone" class="form-label">Phone / WhatsApp</label>
            <InputText id="form-phone" class="form-input" @bind-Value="SubmissionModel.Phone" />
          </div>

          <div class="form-group">
            <label for="form-message" class="form-label">Tell Us About Yourself / Your Message *</label>
            <InputTextArea id="form-message" class="form-textarea" rows="4" @bind-Value="SubmissionModel.Message" required />
            <ValidationMessage For="@(() => SubmissionModel.Message)" />
          </div>

          <button type="submit" class="btn btn-primary" style="width:100%;">
            @(IsSubmitting ? "Sending Application..." : "Send Application")
          </button>
        </EditForm>
      </div>

    </div>
  </div>
</section>

