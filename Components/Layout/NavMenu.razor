@inject AppStateService AppState

<header class="site-header" role="banner">
  <div class="nav-container">
    
    <!-- Left: Brand Logo & Title -->
    <NavLink href="" class="brand" Match="NavLinkMatch.All">
      <div class="brand-logo-wrapper">
        <img src="./assets/images/logo.png" alt="Stories of Inclusion" class="brand-logo-img" width="48" height="48" />
      </div>
      <div class="brand-text-block">
        <span class="brand-title">@AppState.T("brandName")</span>
        <span class="brand-tagline">@AppState.T("tagline")</span>
      </div>
    </NavLink>

    <!-- Center: Primary Nav Links (Collapsible Mobile Drawer) -->
    <nav class="nav-center @(IsMobileMenuOpen ? "open" : "")" aria-label="Main Navigation">
      <ul class="nav-menu">
        <li class="nav-item">
          <NavLink href="" Match="NavLinkMatch.All" class="nav-link" @onclick="CloseMobileMenu">
            <span class="nav-link-text">@AppState.T("navHome")</span>
          </NavLink>
        </li>
        <li class="nav-item">
          <NavLink href="about" class="nav-link" @onclick="CloseMobileMenu">
            <span class="nav-link-text">@AppState.T("navAbout")</span>
          </NavLink>
        </li>
        <!-- Activities with Tactile Dropdown Sub-Buttons -->
        <li class="nav-item nav-item-dropdown @(IsActivitiesDropdownOpen ? "open" : "")"
            @onmouseenter="OnActivitiesMouseEnter"
            @onmouseleave="OnActivitiesMouseLeave">
          <button type="button" 
                  class="nav-link dropdown-toggle-btn @(IsActivitiesActive ? "active" : "") @(IsActivitiesDropdownOpen ? "open" : "")" 
                  @onclick="ToggleActivitiesDropdown" 
                  @onclick:stopPropagation="true"
                  aria-expanded="@(IsActivitiesDropdownOpen ? "true" : "false")"
                  aria-label="Toggle Activities submenu"
                  aria-haspopup="true">
            <span class="nav-link-text">@AppState.T("navActivities")</span>
            <svg class="dropdown-arrow-icon @(IsActivitiesDropdownOpen ? "rotated" : "")" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </button>

          <!-- Dropdown Sub-Buttons Menu -->
          <ul class="dropdown-menu @(IsActivitiesDropdownOpen ? "show" : "")" 
              role="menu" 
              aria-label="Activities Submenu"
              @onclick:stopPropagation="true">
            <li role="none">
              <NavLink href="activities" Match="NavLinkMatch.All" class="dropdown-sub-btn" @onclick="CloseAllMenus" role="menuitem">
                <span class="dropdown-sub-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                </span>
                <div class="dropdown-sub-text">
                  <span class="dropdown-sub-title">@AppState.T("navActivitiesOverview")</span>
                  <span class="dropdown-sub-desc">Empathy sessions & school advocacy</span>
                </div>
              </NavLink>
            </li>
            <li role="none">
              <NavLink href="activities/magazine" class="dropdown-sub-btn" @onclick="CloseAllMenus" role="menuitem">
                <span class="dropdown-sub-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                </span>
                <div class="dropdown-sub-text">
                  <span class="dropdown-sub-title">@AppState.T("navMagazine")</span>
                  <span class="dropdown-sub-desc">Volume 1 & 2 published research</span>
                </div>
              </NavLink>
            </li>
            <li role="none">
              <NavLink href="activities/gallery" class="dropdown-sub-btn" @onclick="CloseAllMenus" role="menuitem">
                <span class="dropdown-sub-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                </span>
                <div class="dropdown-sub-text">
                  <span class="dropdown-sub-title">@AppState.T("navGallery")</span>
                  <span class="dropdown-sub-desc">Field moments with WCAG AA alt text</span>
                </div>
              </NavLink>
            </li>
            <li role="none">
              <NavLink href="blog" class="dropdown-sub-btn" @onclick="CloseAllMenus" role="menuitem">
                <span class="dropdown-sub-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                </span>
                <div class="dropdown-sub-text">
                  <span class="dropdown-sub-title">@AppState.T("navBlog")</span>
                  <span class="dropdown-sub-desc">Field articles, reflections & transcripts</span>
                </div>
              </NavLink>
            </li>
          </ul>
        </li>

        <li class="nav-item">
          <NavLink href="audiobooks" class="nav-link" @onclick="CloseMobileMenu">
            <span class="nav-link-text">@AppState.T("navAudiobooks")</span>
          </NavLink>
        </li>
        <li class="nav-item">
          <NavLink href="blog" class="nav-link" @onclick="CloseMobileMenu">
            <span class="nav-link-text">@AppState.T("navBlogShort")</span>
          </NavLink>
        </li>
        <li class="nav-item">
          <NavLink href="recognition" class="nav-link" @onclick="CloseMobileMenu">
            <span class="nav-link-text">@AppState.T("navAwards")</span>
          </NavLink>
        </li>
        <li class="nav-item">
          <NavLink href="team" class="nav-link" @onclick="CloseMobileMenu">
            <span class="nav-link-text">@AppState.T("navTeam")</span>
          </NavLink>
        </li>
        <li class="nav-item">
          <NavLink href="store" class="nav-link" @onclick="CloseMobileMenu">
            <span class="nav-link-text">@AppState.T("navStore")</span>
          </NavLink>
        </li>
      </ul>

      <!-- Mobile-only Drawer Actions (CTA + Dashboard + Role Switcher) -->
      <div class="mobile-drawer-actions">
        <NavLink href="contact" class="btn btn-primary btn-mobile-cta" @onclick="CloseMobileMenu">
          <span>@AppState.T("navJoin")</span>
          <span aria-hidden="true">→</span>
        </NavLink>

        @if (AppState.CurrentRole == AppRole.Guest)
        {
          <NavLink href="login" class="btn btn-mobile-login" @onclick="CloseMobileMenu">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
            <span>@AppState.T("navSignIn")</span>
          </NavLink>
        }
        else
        {
          <NavLink href="@GetDashboardUrl()" class="btn btn-mobile-dash" @onclick="CloseMobileMenu">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
            <span>Open @AppState.GetRoleDisplayName() Dashboard</span>
          </NavLink>

          <button type="button" @onclick="HandleLogout" class="btn btn-mobile-logout">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span>@AppState.T("navSignOut")</span>
          </button>
        }

        <button type="button" @onclick="OpenRbacModal" class="btn btn-mobile-role">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
          <span>Switch Role: @AppState.GetRoleDisplayName()</span>
        </button>
      </div>
    </nav>

    <!-- Right: Actions Cluster -->
    <div class="nav-actions">
      <!-- Direct Dashboard Shortcut when authorized (Desktop/Tablet) -->
      @if (AppState.CurrentRole != AppRole.Guest)
      {
        <NavLink href="@GetDashboardUrl()" class="btn-nav-dashboard desktop-only-action" title="Open Your Role Dashboard">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
          <span>Dashboard</span>
        </NavLink>

        <button type="button" @onclick="HandleLogout" class="btn-nav-logout desktop-only-action" title="Sign Out of Your Account">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          <span>@AppState.T("navSignOut")</span>
        </button>
      }
      else
      {
        <NavLink href="login" class="btn-nav-login desktop-only-action" title="Sign In to Member or Staff Account">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
          <span>@AppState.T("navSignIn")</span>
        </NavLink>
      }

      <!-- Single Join Us CTA Button (Desktop/Tablet) -->
      <NavLink href="contact" class="btn-nav-join desktop-only-action">
        <span>@AppState.T("navJoin")</span>
        <span aria-hidden="true" class="btn-arrow">→</span>
      </NavLink>

      <!-- Role & Admin Manager Pill Button -->
      <button type="button" id="btn-open-rbac-modal" @onclick="OpenRbacModal" class="role-pill-btn" aria-haspopup="dialog" aria-expanded="false" title="Switch or simulate system roles (Admin Manager)">
        <span class="role-badge-status @GetRoleStatusClass()" aria-hidden="true"></span>
        <span class="role-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
        </span>
        <span class="role-pill-text">@AppState.GetRoleDisplayName()</span>
        <span class="role-pill-chevron" aria-hidden="true">▾</span>
      </button>

      <!-- Mobile Hamburger Toggle -->
      <button type="button" class="mobile-nav-toggle" @onclick="ToggleMobileMenu" aria-label="Toggle Navigation Menu" aria-expanded="@IsMobileMenuOpen">
        @if (IsMobileMenuOpen)
        {
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        }
        else
        {
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        }
      </button>
    </div>

  </div>

  @if (IsActivitiesDropdownOpen)
  {
    <div class="dropdown-backdrop" @onclick="CloseActivitiesDropdown" aria-hidden="true"></div>
  }
</header>
